# Copy to .env, then replace every example. Do not commit .env.
# Passwords used in PostgreSQL URLs must be URL-safe characters only.
SAMURAI_POSTGRES_OWNER_PASSWORD=change-me-owner-password
SAMURAI_DATABASE_RUNTIME_PASSWORD=change-me-runtime-password
# 32文字以上のランダム値。生成例: openssl rand -base64 48
SAMURAI_INVITATION_TOKEN_SECRET=replace-with-a-long-random-secret

# One Docker compose file is one Self-host Workspace.
SAMURAI_SELF_HOST_WORKSPACE_ID=workspace_home
# Use create for a new Workspace. A fresh restore target must use empty so the
# Bundle can create and validate the target Workspace before it becomes active.
SAMURAI_SELF_HOST_BOOTSTRAP_MODE=create
# The command calculates this ID from the public key. Keep the private key out
# of this file, Bundles, and the Workspace directory.
SAMURAI_INITIAL_ADMIN_ID=account_replace-with-generated-id
# Ed25519 SPKI public key. Generate with: pnpm server:02:account -- --output ./owner-identity.json
SAMURAI_INITIAL_ADMIN_PUBLIC_KEY=base64:replace-with-public-key
SAMURAI_INITIAL_ADMIN_DISPLAY_NAME=Owner
SAMURAI_SERVER_PORT=4317
# The direct port is loopback-only unless you intentionally change this.
SAMURAI_SERVER_BIND_ADDRESS=127.0.0.1
SAMURAI_SERVER_PUBLIC=0
# When SAMURAI_SERVER_PUBLIC=1, place the Server behind a TLS reverse proxy
# and set exact https origins separated by commas. Do not publish plain HTTP.
SAMURAI_CORS_ORIGINS=
# Required for public operation. This fixed HTTPS origin is put into Native
# App invitation links; do not rely on a request Host header.
SAMURAI_PUBLIC_BASE_URL=
# Absolute path outside the Docker Workspace volume. Create it with restrictive
# permissions before running backup.sh. A separate disk is recommended.
SAMURAI_BACKUP_DIR=/absolute/path/to/samurai-backups

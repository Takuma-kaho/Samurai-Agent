# Samurai Agent LLM provider settings
#
# Copy this file to .env before local development:
#   cp .env.example .env
#
# Keep real API keys only in .env. The .env file is ignored by git.
#
# Model refs use provider/model format.
# Examples:
#   SAMURAI_LLM_MODEL=gemini/gemini-3.5-flash
#   SAMURAI_LLM_MODEL=openai/gpt-5.5
#   SAMURAI_LLM_MODEL=anthropic/claude-sonnet-4.6
#   SAMURAI_LLM_MODEL=openrouter/openai/gpt-5.5
#   SAMURAI_LLM_MODEL=openai-compatible/local-model

PORT=4317
WORKSPACE_DATA_DIR=

SAMURAI_LLM_MODEL=
SAMURAI_LLM_FALLBACKS=

OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

SAMURAI_OPENAI_COMPATIBLE_BASE_URL=
SAMURAI_OPENAI_COMPATIBLE_API_KEY=

# External Assist stays unverified and does not become Memory automatically.
# Set SAMURAI_EXTERNAL_ASSIST_URL for an HTTP provider, SAMURAI_EXTERNAL_ASSIST_FILE
# for one local JSON/JSONL provider, or SAMURAI_EXTERNAL_ASSIST_FILES for multiple
# local providers separated by the platform path delimiter or commas.
# The HTTP provider receives POST JSON for prefetch/sync and returns:
# { "hints": [{ id, title, summary/content, source_label, source_uri, confidence }] }
SAMURAI_EXTERNAL_ASSIST_URL=
SAMURAI_EXTERNAL_ASSIST_TOKEN=
SAMURAI_EXTERNAL_ASSIST_AUTH_HEADER=
SAMURAI_EXTERNAL_ASSIST_TIMEOUT_MS=5000
# The local file provider accepts JSON array or JSONL records with:
# id, title, summary/content, source_label, source_uri, keywords, confidence.
SAMURAI_EXTERNAL_ASSIST_FILE=
SAMURAI_EXTERNAL_ASSIST_FILES=
SAMURAI_EXTERNAL_ASSIST_PROVIDER_ID=
SAMURAI_EXTERNAL_ASSIST_PROVIDER_IDS=
SAMURAI_EXTERNAL_ASSIST_MAX_HINTS=5

# Agent Backend cassette selection
#
# samurai-native is the built-in host backend.
# claude-code and codex call external CLI processes when their commands are set.
# External CLI commands must be executable on PATH or an absolute executable path.

SAMURAI_BACKEND_DEFAULT=samurai-native

SAMURAI_CLAUDE_CODE_COMMAND=
SAMURAI_CLAUDE_CODE_ARGS=
SAMURAI_CLAUDE_CODE_TIMEOUT_MS=
SAMURAI_CLAUDE_CODE_STREAM_PROBE_ARGS=
SAMURAI_CLAUDE_CODE_STREAM_PROBE_TIMEOUT_MS=
SAMURAI_CLAUDE_CODE_RESUME_ARGS=

SAMURAI_CODEX_COMMAND=
SAMURAI_CODEX_ARGS=
SAMURAI_CODEX_TIMEOUT_MS=
SAMURAI_CODEX_STREAM_PROBE_ARGS=
SAMURAI_CODEX_STREAM_PROBE_TIMEOUT_MS=
SAMURAI_CODEX_RESUME_ARGS=

# Runtime switches

SAMURAI_AUTOMATION_SCHEDULER=true
SAMURAI_AUTOMATION_TICK_MS=60000
SAMURAI_BROWSER_ADAPTER=
SAMURAI_EXTERNAL_SEND_DISPATCH=false
SAMURAI_DEV_HEALTH_WARN_MS=10000

# Optional non-dry-run external send transports.
# Leave tokens empty unless you intentionally enable SAMURAI_EXTERNAL_SEND_DISPATCH.
SAMURAI_SLACK_BOT_TOKEN=
SAMURAI_SLACK_API_URL=https://slack.com/api/chat.postMessage
SAMURAI_TELEGRAM_BOT_TOKEN=
SAMURAI_TELEGRAM_API_BASE_URL=https://api.telegram.org
SAMURAI_LINE_CHANNEL_ACCESS_TOKEN=
SAMURAI_LINE_API_BASE_URL=https://api.line.me/v2/bot/message
SAMURAI_EMAIL_SMTP_HOST=
SAMURAI_EMAIL_SMTP_PORT=587
SAMURAI_EMAIL_SMTP_SECURE=false
SAMURAI_EMAIL_SMTP_STARTTLS=true
SAMURAI_EMAIL_SMTP_USER=
SAMURAI_EMAIL_SMTP_PASSWORD=
SAMURAI_EMAIL_FROM=
SAMURAI_EMAIL_ADDRESS=
SAMURAI_EMAIL_IMAP_HOST=
SAMURAI_EMAIL_IMAP_PORT=993
SAMURAI_EMAIL_IMAP_SECURE=true
SAMURAI_EMAIL_IMAP_USER=
SAMURAI_EMAIL_IMAP_PASSWORD=
SAMURAI_EMAIL_IMAP_MAILBOX=INBOX
SAMURAI_EMAIL_IMAP_MAX_MESSAGES=10
SAMURAI_EMAIL_IMAP_MARK_SEEN=false
SAMURAI_EMAIL_IMAP_TIMEOUT_MS=10000
SAMURAI_EMAIL_POSTMARK_WEBHOOK_USERNAME=
SAMURAI_EMAIL_POSTMARK_WEBHOOK_PASSWORD=
SAMURAI_EMAIL_MAILGUN_SIGNING_KEY=
SAMURAI_EMAIL_SENDGRID_WEBHOOK_PUBLIC_KEY=

# Optional Slack inbound signature verification.
# When set, /api/gateway/slack/events requires valid X-Slack-Signature and
# X-Slack-Request-Timestamp headers. Keep the real signing secret only in .env.
SAMURAI_SLACK_SIGNING_SECRET=
# Optional Telegram inbound webhook verification.
# When set, /api/gateway/telegram/updates requires X-Telegram-Bot-Api-Secret-Token.
SAMURAI_TELEGRAM_WEBHOOK_SECRET=
# Optional LINE inbound signature verification.
# When set, /api/gateway/line/events requires a valid X-Line-Signature.
SAMURAI_LINE_CHANNEL_SECRET=

# Optional comma-separated Gateway source identities for operations review.
# Example: SAMURAI_GATEWAY_SOURCE_ALLOWLIST=webhook:github,local_cli:runner
SAMURAI_GATEWAY_SOURCE_ALLOWLIST=

# Samurai Agent LLM provider settings
#
# Copy this file to .env before local development:
#   cp .env.example .env
#
# Keep real API keys only in .env. The .env file is ignored by git.
#
# Model refs use provider/model format.
# Examples:
#   SAMURAI_LLM_MODEL=gemini/gemini-3.5-flash
#   SAMURAI_LLM_MODEL=openai/gpt-5.5
#   SAMURAI_LLM_MODEL=anthropic/claude-sonnet-4.6
#   SAMURAI_LLM_MODEL=openrouter/openai/gpt-5.5
#   SAMURAI_LLM_MODEL=openai-compatible/local-model

SAMURAI_LLM_MODEL=
SAMURAI_LLM_FALLBACKS=

OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

SAMURAI_OPENAI_COMPATIBLE_BASE_URL=
SAMURAI_OPENAI_COMPATIBLE_API_KEY=

# Agent Backend cassette selection
#
# samurai-native is the built-in host backend.
# claude-code and codex call external CLI processes when their commands are set.

SAMURAI_BACKEND_DEFAULT=samurai-native

SAMURAI_CLAUDE_CODE_COMMAND=
SAMURAI_CLAUDE_CODE_ARGS=
SAMURAI_CLAUDE_CODE_TIMEOUT_MS=

SAMURAI_CODEX_COMMAND=
SAMURAI_CODEX_ARGS=
SAMURAI_CODEX_TIMEOUT_MS=

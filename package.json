{
  "name": "samurai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter @samurai-agent/web run build",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "pnpm --parallel --filter @samurai-agent/server --filter @samurai-agent/web run dev",
    "doctor": "node scripts/doctor.mjs",
    "i18n:check": "pnpm --filter @samurai-agent/localization run check",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "kysely": "^0.27.6",
    "lucide-vue-next": "^0.468.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.38",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}

{
  "name": "@samurai-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "pnpm run typecheck && pnpm run bundle",
    "bundle": "pnpm run bundle:main && pnpm run bundle:preload",
    "bundle:main": "vite build --config vite.main.config.ts",
    "bundle:preload": "vite build --config vite.preload.config.ts",
    "dev": "pnpm run bundle && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@samurai-agent/domain-api": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@samurai-agent/workspace-server": "workspace:*",
    "electron": "^43.1.0",
    "vite": "^6.4.3"
  }
}

{
  "name": "@samurai-agent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "workspace-server": "tsx src/workspace-server-entry.ts",
    "workspace-server:admin": "tsx src/workspace-server-admin-cli.ts",
